# Cron alternative to the systemd `run` loop — one scan per invocation (--once).
# NSE session is 09:15–15:30 IST. Times below are IST; make sure the host clock is
# Asia/Kolkata (or set TZ=) or convert to your server's timezone.
#
#   crontab -e   →   TZ=Asia/Kolkata
TZ=Asia/Kolkata
PATH=/opt/precision-tap/.venv/bin:/usr/local/bin:/usr/bin:/bin
MAILTO=""

# IMPORTANT: plain `scan` (auto mode) everywhere — the mode follows the *market
# clock*, not the trigger.  Forcing `--live` outside 09:15–15:30 makes every
# symbol skip with "live bar unavailable" (there is no forming bar to read),
# and forcing `--eod` mid-session blinds the cycle to intraday taps.
#
# intraday touch checks every 15 min during the session (first at 09:30, once
# the opening prints exist; last at 15:30, the closing auction)
30,45 9 * * 1-5     cd /opt/precision-tap && python -m precision_tap scan >> logs/cron.log 2>&1
*/15 10-14 * * 1-5   cd /opt/precision-tap && python -m precision_tap scan >> logs/cron.log 2>&1
0,15,30 15 * * 1-5   cd /opt/precision-tap && python -m precision_tap scan >> logs/cron.log 2>&1
# the close print + settled EOD bar (authoritative, closed-bar = indicator-exact)
35 15 * * 1-5      cd /opt/precision-tap && python -m precision_tap scan >> logs/cron.log 2>&1
10 16 * * 1-5      cd /opt/precision-tap && python -m precision_tap scan >> logs/cron.log 2>&1
# weekly housekeeping + a fresh data cache for weekend backtesting
45 18 * * 0        cd /opt/precision-tap && python -m precision_tap export-data --days 2000 >> logs/cron.log 2>&1
55 18 * * 0        cd /opt/precision-tap && sqlite3 data/state.sqlite3 "DELETE FROM alerts WHERE created_at < datetime('now','-120 day'); DELETE FROM runs WHERE started_at < datetime('now','-120 day');" >> logs/cron.log 2>&1
