# ── Telegram (create a bot with @BotFather → /newbot) ─────────────────────────
# 1. paste the token below (or export it), 2. message your bot /start,
# 3. run:  python -m precision_tap telegram-test --discover   → prints TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample
TELEGRAM_CHAT_ID=987654321

# ── optional overrides read by precision_tap ─────────────────────────────────
# PRECISION_TAP_PROVIDER=yfinance          # yfinance | yahoo | csv | synthetic
# PRECISION_TAP_UNIVERSE=universe/nse.txt  # or: nifty50 | nifty100 | nifty500 | sensex30
# PRECISION_TAP_SYMBOLS=RELIANCE,TCS,INFY   # ad-hoc watchlist (suffix .NS auto-added)
# HTTPS_PROXY=http://127.0.0.1:7890         # also used for Telegram
